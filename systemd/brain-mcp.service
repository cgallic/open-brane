[Unit]
Description=Open Brane authenticated HTTP MCP and browser UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace <BRAIN_ROOT> with the absolute clone path and <USER> with its owner.
# Run python3 brane.py setup as that user before enabling this service.
User=<USER>
WorkingDirectory=<BRAIN_ROOT>
ExecStart=<BRAIN_ROOT>/.venv/bin/python <BRAIN_ROOT>/scripts/starter.py serve --config <BRAIN_ROOT>/data/starter.json --host 127.0.0.1 --port 7778
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
