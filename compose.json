{
  "services": {
    "brane": {
      "build": ".",
      "ports": ["127.0.0.1:7778:7778"],
      "volumes": ["brane-data:/data"],
      "restart": "unless-stopped",
      "security_opt": ["no-new-privileges:true"],
      "cap_drop": ["ALL"],
      "stop_grace_period": "30s"
    }
  },
  "volumes": {"brane-data": {}}
}
